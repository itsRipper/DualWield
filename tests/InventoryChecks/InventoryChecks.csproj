<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <SptRoot Condition="'$(SptRoot)' == ''">$(SPT_ROOT)</SptRoot>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Common.dll</HintPath></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.DI.dll</HintPath></Reference>
  </ItemGroup>
</Project>
